{Entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.4))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "light_M" "turret_rotator" "vision_lev05" "remote_turret" "has_apu" "sam_radar" "buk_launcher"}
	{targetSelector "missile"}
	{extender "enumerator"}
	{volume "body1"
		{tags "body"}
		{component "body"}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
	}
	{volume "turret"
		{tags "turret"}
		{component "turret"}
	}
	{volume "turret2"
		{tags "turret"}
		{component "turret"}
	}
	("armor_light" turret(7 7 7 7) body(7 7 7 7))

;===================================================================

	{boarder
		{anm "driver"
			{forward	{begin	"board_tank"} {end "seat_gunner_stand"} {base "open" -1}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open"}}
		}
		{anm "right"
			{forward	{begin	"board_tank"} {end "seat_gunner_stand"} {base "open1"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open1" -1}}
		}

	}
	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
		{link "emit1" "gunner" {anm "right"} {forward putoff} {reverse puton}}
		{link "emit1" "commander" {anm "right"} {forward putoff} {reverse puton}}
		{link "emit1" "charger" {anm "right"} {forward putoff} {reverse puton}}
	}
	("crew_human" place(commander)	 	door2(emit1) visor(main1))
	("crew_human" place(gunner)	 	door2(emit1) visor(visor_radar))
	("crew_human" place(charger)	 	door2(emit1) visor(char))


;===================================================================
	{extender "inventory"
		{box
			{Size 7 6}
			{weight 3000}
                {item "netting_kit" 5}
                {item "9m317 buk ammo" 4}
		}
	}

	{Weaponry
		{place "radar"
			{weapon "targeting_radar_bukm2" filled}
			{foresight "radar_foresight"}
			{charger "commander"}
			{gunner "commander"}
			{SequentialAim 0}
			{RestoreIKAfterAim}
		;	{StationaryFiring}	;мешает повороту пусковой
		}
		{place "gun2"
			{weapon "buk_launcher" filling "9m317 buk ammo" 4}  
			{gunner "gunner"}
			{charger "gunner"}  
			{foresight "foresight1"}    
			{shooter "none"}
			{basic}
			{Barrels 4}
			{SequentialAim 0}
			{RestoreIKAfterAim}
		}
	}

;===================================================================
	{Sensor
		{RecognizeTime 0.01}
		{Visor "driver"
			{vision "vehicle_top_mgun"}
			{bone "visor2"}
		}
		{Visor "char"
			{vision "vehicle_top_mgun"}
			{bone "visor3"}
		}
		{Visor "main1"
			{vision "tank_main-l"}
			{bone "visor4"}
		}
		{Visor "visor_radar"
			{vision "radarX_buk_120km"}	;A-10 на 390м
			{bone "visor1"}
		}
		{Visor "passive"
			{vision "vertical_antimissile"}
			{bone "turret"}
		}
	}
	("sam_radar" type(rus_large))

;===================================================================
	{mass 32400}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.2))
		{Locomotion ("CW_track_moveparam" 
			Mass(32.4)
			Width(3.25)
			Power(750)
			Realspeed(65)
			Gamespeed(41) 
		)
		{RearGears		0.20 0.44}}
		("CW_fuelbag" Range(500) Fuelvolume(990))
		("CW_speed_lev" Gamespeed(41))
		{DisableMoveWhileFiring}
	}
	{props "cwfs_fuel_800"}

	("two_headlights")
	{Extension "buk_m2.mdl"}
	("missile_aimpoint_tanksize")
	("cwts_buksir")
	{bone "radar_m2"
		{terminator}
	}
	{bone "radar_foresight_rot"
		{limits -45 45}
	}
}
