	}
	{volume "body2"
		{tags "body"}
		{component "body"}
	}
	{volume "turret"
		{tags "turret"}
		{component "turret"}
	}



	("armor_medium" turret(140 140 30 25) body(70 32 25 20))  
	("comp_armor_increment" turret(28 28 28 40) body(28))	
	("armor_mantlet" t(80)) 
	("armor_engine"  t(30))

