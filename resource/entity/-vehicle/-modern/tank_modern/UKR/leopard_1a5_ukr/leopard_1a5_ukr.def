("shield_t-64a_1981")



;====================================

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "M1a1_mgun2"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "M1a1_mgun2"}{base "open"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "M1a1_mgun2"}{base "open_c"}}
			{reverse 	{end	"emit_tank_2_hold"}	{base "open_c" -1}}
		}
		{anm "armor"
			{forward	{begin	"board_highArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}
	("crew_inside")	
	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}
	("crew_human" place(commander)		door1(emit2) door2(emit1) visor(commander))
	("crew_human" place(gunner)	 	door1(emit2) door2(emit1)  visor(main))
	("gunner_visible")

	{sensor
		{visor "main"
			{vision "tank_gunner_optic_IR_2g"}
			{bone "visor_emes"}
		}
		{visor "commander"
			{vision "tank_gunner_optic_2g"}
			{bone "Visor3"}
		}
		{visor "up"
			{vision "vehicle_top_mgun"}
			{bone "mgun3"}
		}
	}


;=================================================	
	{extender "inventory"
		{box
			{item "ammo bullet105_GER ap" 10}
			{item "ammo bullet105_IDF apcr" 22}
			{item "ammo bullet105_USA cm" 22}
			{item "ammo 762Nato" 5500}
			{item "ammo smoke_shtora" 8}	
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "105mm_L7A3_ua" filling "ammo bullet105_IDF apcr" 1}	
			{gunner "gunner"}
			{charger "gunner"}                 
			("CW_stab_abm" abm(0.37))
			("CW_stab_ld_suo")
		}
		{place "mgun1"
			{type "mgun_aa"}
			{weapon "MG3" filled}
			{linkbone "mgun3"}
			{foresight "foresight6"}
			{gunner "gunner2"}
			{charger "gunner2"}                 
			{basic}
			("CW_stab_no_stabiliser")
		}
		{place "mgun"
			{type "mgun_coaxial"}
			{weapon "MG3" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "gunner"} 
			{basic}
			("CW_stab_abm" abm(0.86))
			("CW_stab_ld_suo")
		}
		{place "mgun18"			
			{type "mgun_left"}
			{weapon "4xsmokegun_bredly" filling "smoke_shtora ammo" 4}
			{gunner "gunner"}
			{charger "gunner"}
			{foresight "foresight21"}
			{barrels 4}
			{basic}
		}
		{place "mgun19"			
			{type "mgun_right"}
			{weapon "4xsmokegun_bredly" filling "smoke_shtora ammo" 4}
			{gunner "gunner"}
			{charger "gunner"}
			{foresight "foresight20"}
			{barrels 4}
			{basic}
		}
	}

	{mass 45000}
	{Chassis
		("tank_trace" fx("tracks_big") step(10.47) len(1.0))
		{Locomotion ("CW_track_moveparam" 
			Mass(45.0)
			Width(3.37)
			Power(819)
			Realspeed(65)
			Gamespeed(41) 
		)
		{RearGears		0.20 0.50}}
		("CW_fuelbag" Range(600) Fuelvolume(985))
		("CW_speed_lev" Gamespeed(41))
	}
	{props "cwfs_fuel_800"}

	("two_headlights")
	{Extension "leopard_1a5_ukr.mdl"}
	("missile_aimpoint_tanksize")
	("cwts_buksir")
	("recoil_side_common")
	("CW_turr_speed" deg_per_s(30))
	("cw_suspension_7tracks" downmax(-0.12) upmax(0.28))
}

