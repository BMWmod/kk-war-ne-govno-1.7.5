{Entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.4))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "light_M" "turret_rotator" "vision_lev05" "remote_turret" "has_apu" "2k11_krug"}
	{targetSelector "missile"}
	{extender "enumerator"}
	{volume "body1"
		{tags "body"}
		{component "body"}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
	}
	{volume "turret"
		{tags "turret"}
		{component "turret"}
	}
	{volume "turret2"
		{tags "turret"}
		{component "turret"}
	}
	("armor_light" turret(10 10 10 10) body(15 15 8 15))

;===================================================================

	{extension "krug_crew.ext"}

    {extender "cannon"
        {animation {move "" ""} {reload "" ""} {aim "" ""}}
        {animation {switch krug_close}}
        {move {workers "gunner_travel" "charger_travel"}}
        {attack {workers "gunner" "charger"}}
        {rotate_ik_Limit 0}
    }

	{extender "inventory"
		{box
			{Size 7 6}
			{weight 3000}
                {item "netting_kit" 5}
                {item "3m8_krug_rocket ammo" 2}
		}
	}

	{Weaponry
		
		{place "gun2"
			{weapon "3m8_krug_x2" filling "3m8_krug_rocket ammo" 2}  
			{gunner "gunner"}
			{charger "charger"}  
			{foresight "foresight1"}    
			{shooter "none"}
			{basic}
			{Barrels 2}
			{SequentialAim 0}
			{RestoreIKAfterAim}
            {StationaryFiring}
		}
	}

;===================================================================
	{Sensor
		{RecognizeTime 0.01}
		{Visor "driver"
			{vision "vehicle_top_mgun"}
			{bone "visor2"}
		}
		{Visor "char"
			{vision "vehicle_top_mgun"}
			{bone "visor3"}
		}
		{Visor "main1"
			{vision "tank_main-l"}
			{bone "visor4"}
		}
		
		{Visor "passive"
			{vision "vertical_antimissile_side"}
			{bone "turret"}
		}
	}
	

;===================================================================
	{mass 28000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.2))
		{Locomotion ("CW_track_moveparam" 
			Mass(28)
			Width(3.6)
			Power(400)
			Realspeed(50)
			Gamespeed(35) 
		)
		{RearGears		0.20 0.44}}
		("CW_fuelbag" Range(350) Fuelvolume(800))
		("CW_speed_lev" Gamespeed(35))
		{DisableMoveWhileFiring}
	}
	{props "cwfs_fuel_800"}

	("two_headlights")
	{Extension "2k11_krug.mdl"}
	("missile_aimpoint_tanksize")
	("cwts_buksir")
	
	
}
