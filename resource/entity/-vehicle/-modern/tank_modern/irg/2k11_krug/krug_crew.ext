; Explicit internal crew and boarding graph. Alternate stations are cannon modes,
; not extra passengers. Keep the four initial occupants before alternate places.
; Like 2k12_kub, internal places must not have LinkBone or a seated end pose:
; LinkBone opts into visible occupants and draws the crew above the hull.
{placer
    {crew}
    {place "driver" {group "crew"} {visor "driver"}}
    {place "commander" {group "crew"} {visor "main1"}}
    {place "gunner_travel" {group "crew"} {visor "passive"}}
    {place "charger_travel" {group "crew"} {visor "char"}}
    {place "gunner" {group "crew"} {visor "passive"}}
    {place "charger" {group "crew"} {visor "char"}}
}
{boarder
    {door "emit0"}
    {door "emit1"}
    {anm "krug_board_left"
        {forward {begin "board_tank_left"}}
        {reverse {end "emit_tank_1_hold"}}
    }
    {anm "krug_board_right"
        {forward {begin "board_tank_right"}}
        {reverse {end "emit_tank_1_hold"}}
    }
    {link "emit0" "driver" {anm "krug_board_left"} {forward putoff} {reverse puton}}
    {link "emit1" "commander" {anm "krug_board_right"} {forward putoff} {reverse puton}}
    {link "emit0" "gunner_travel" {anm "krug_board_left"} {forward putoff} {reverse puton}}
    {link "emit1" "charger_travel" {anm "krug_board_right"} {forward putoff} {reverse puton}}
    {link "emit0" "gunner" {anm "krug_board_left"} {forward putoff} {reverse puton}}
    {link "emit1" "charger" {anm "krug_board_right"} {forward putoff} {reverse puton}}
    {link "gunner_travel" "gunner"}
    {link "charger_travel" "charger"}
}
