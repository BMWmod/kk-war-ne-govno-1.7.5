{entity
	(include "/properties/cannon.ext")
	(include "/properties/shadow/tank.inc"  scale(0.5))
	{props "vehicle" "cannon" "heavy" "wheeled" "vision_lev04_can" "round_sandbag2" "trailer"}
	{PatherId "cannon.large"}
	("armor_heavy")
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{collider "cannon"}

	{volume "shield"
		{tags "body"}
		{component "body"}
	}
	{volume "body"
		{tags "body"}
		{component "body"}
	}

	; crew: as Giatsint-B
	("crew_wheeled_gun")
	{boarder
		{anm "gunner"
			{forward	{end "pose_pak40_gunlayer" 10}}
		}
		{anm "commander"
			{forward	{end "pose_pak40_charger" 10}}
		}
		{anm "driver1"
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "seat1"
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"
			{forward {end "pose_seat_cannon_right" 10}}
		}
	}
	("wheel" args "wheelright")
	("wheel" args "wheelleft")
	; ammo: as FH-70
	{extender "inventory"
		{box
			{Size 8 8}
			{weight 10000}
			{item "ammo bullet155_GER fg" 25}
			{item "ammo bullet155_USA cl" 5}
			{item "ammo bullet155_GER_ar fg" 5}
			{item "repair_kit" 1}
		}
	}
	{Weaponry
		{place "gun"
			{weapon "155mm_bohdana_bg" filling "bullet155_GER fg" 1}
			{RestoreIKAfterAim}
			{Rotate}
			("abm_howitzer_rt" rechargetime(8))
		}
	}

	{mass 9600}
	{Extension "bohdana_bg.mdl"}
	("missile_aimpoint_wieselsize")
	(include "/properties/selection/cannon.inc"  scale(0.7))

	{bone "basis"
		{speed 0.005}
	}
	{bone "turret"
		{limits -12 12}
		{speed 0.003}
	}
	{bone "gun_rot"
		{limits -54 5}
		{speed 0.006}
	}
	{extender "cannon"
		{animation
			{switch "close"}
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right"}
			{aim "cannon_zis3_gunlayer" ""}
			{fire  "Cannon_gunlayer_fire-alert" "cannon_zis3_charger_fire 0.13"}
			{reload  "" "Cannon_zis3_charger"}
		}
		{move {obstacle "close"}}
		{attack {obstacle "open"}}
	}

	; movement: FH-70 (APU), 4x slower
	{Chassis "track"
		("car_trace" fx("tracewheel03") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		{locomotion
			("loco_params")
			{FallSlope  60}
			{MaxSpeed	4}
			{StartTime	5}
			{TurnTime	20}
			{TurnRadius	3}
		}
	}
	{sensor
		{visor "main"
			{vision "cannon_main-far"}
		}
	}
}
