{Entity
	(include "/properties/airborne_M.ext")	;
	{PatherID  "airborne"}
	(include "/properties/shadow/airborn.inc" scale(1.1))
	(include "/properties/selection/airborne.inc" scale(3.0))
	(include "/properties/car_crew.ext")
	{props "airborne_M" "fighter" "vision_lev_small_UAV" "small_UAV" "loitering_uav" "geran5" "-smalluav_irn" "altmax_40m" "-radar_spo" "-IR_spo" "cw_autotakeoff"}	
	;controller prop - "smalluav_irn_control"
	{Extension "geran5.mdl"}
		("missile_aimpoint_custom" height(0) front(0) side(0))
	{collider "particle.big"}
	{targetClass 	"geran5_uav"}
	{targetSelector "cannon_bullet"}
	{mass 200}
	{Volume "armor1"}
	;own damage model instead of "air_armor": module durability is ~1/3 of the standard airborne values
	{armor
		{setting "body" {thickness 3}
			{durability {blast {value 20}} {pierce {value 33}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "body*"}
		}
		{setting "wing" {thickness 3}
			{durability {blast {value 5}} {pierce {value 27}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "wing*"}
		}
		{setting "tail" {thickness 3}
			{durability {blast {value 3}} {pierce {value 27}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "tail*"}
		}
		{setting "engine" {thickness 3}
			{durability {blast {value 2}} {pierce {value 10}}}
			{threshold {blast {value 1.5}} {pierce {value 3}}}
			{volumes "engine*"}
		}
		{setting "hydrosystem" {thickness 3}
			{durability {blast {value 2}} {pierce {value 5}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "hydrosystem*"}
		}
		{setting "electronics" {thickness 3}
			{durability {blast {value 2}} {pierce {value 5}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "electronics*"}
		}
		{setting "fuel_tank_internal_a" {thickness 3}
			{durability {blast {value 3}} {pierce {value 12}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "fuel_tank_internal_a*"}
		}
		{setting "fuel_tank_internal_b" {thickness 3}
			{durability {blast {value 3}} {pierce {value 12}}}
			{threshold {blast {value 3}} {pierce {value 3}}}
			{volumes "fuel_tank_internal_b*"}
		}
		("armor_panel" name(armor) thickness(2.5))
		{setting "armor"
			{thickness 2.5}
			{volumes "armor*"}
		}
	}
	{extender "inventory"
		{box
			{clear}
		}
	}
	{Weaponry
		{place "mark"
			{weapon "geran5_mark" filling "geran5_ammo ammo" 1}
			{foresight "foresight1"}
			{charger "driver"}
			{gunner "driver"}
			{basic}
		}
		{place "straight"
			{weapon "spot" filled}
			{foresight "aiming_mark"}
			{basic}
		}
	}
	{extender "stuff"
		{item "geran5_base_impactor_direct_hit fg"}
	}
{Extender "preview"
	{"Stuff"
		{camera
			{origin 47.1027	-91.7563	14.3619}
			{lookat 1.33385	-4.0601	0.945669}
			{fov 9.5929}
			{horizon 2.83041}
		}
		{lights
			{"0"
				{type point}
				{position 4.23843	-5.67377	10.8797}
			}
			{"1"
				{type directional}
				{direction -0.0793779	0.377597	-0.317993}
			}
			{"2"
				{type point}
				{position -4.39621	-4.88662	8.11211}
			}
		}
	}
}
("Chassis_parameters" 
	Speed(80) TurnRadius(25)
	Fuel(60) Fuel_remain(59) Fuel_rate(0.05) 
;	Acc_hor(4.31) Maneuvrability_hor(8.97)
;	Acc_ver(1.46) Maneuvrability_ver(0.46)
	Acc_hor(2.15) Maneuvrability_hor(4.5)
	Acc_ver(5) Maneuvrability_ver(5)
	;����������� ����� �� �������, ��������� �� �������� �������������.
)
 {Chassis "wheel"
	{locomotion ("locomotion")
		{MaxSpeed 1} 
		{StartTime 		1  } 
		{BrakeTime 		0.01  } 
		{StopTime		0.01  }    
	}
 }
	{Sensor
	    {Visor "radarX"
			{vision "aircraft_radarX_60km"}
			{bone "visor_ols"}
		}
	}		
	{brain
		{properties
			{control user}
			{fire_mode hold}
		}
	}
	{Chassis "airborne"
			{Altitude 15}
			; Air launch: engage flight speed without the inherited ground-style run-up.
			{locomotion
				{Maxspeed 80}
				{turnRadius 25}
				{StartTime 0.1}
				{BrakeTime 6.4}
				{StopTime 9.6}
			}
		}
	{ChassisManager
			{Current "airborne"}
	}
       {autooperatable 1}
       {placer
          {crew 0}
          {place "driver" remove}
       }
}