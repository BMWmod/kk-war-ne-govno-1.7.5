;Hawkeye 105mm SPH on armored HMMWV - KK War
{Entity
	(include "/properties/car.ext")
	(include "/properties/shadow/tank.inc"  scale(0.9))
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "vehicle" "turret" "turret_rotator" "wheeled" "4_wheels" "windowed" "vision_lev05" "cw_artillery" "hmmwv" "hawkeye_armor"}
	{PatherId "vehicle.small"}
	;armored cab, open gun platform
	("armor_car_M" body(0.75) cabin(5) dur_value(12) dur(0.5) thr(0.25) engine(4) body_back(1) wheel(2) wheel_val(2) mrap(1) mrap_val(1))

	{Volume "gun"
		{tags "gun"}
		{component "gun"}
		{thickness 9}
	}
	{Volume "gun_rot"
		{tags "gun"}
		{component "gun"}
		{thickness 6}
	}
	{Volume "glass"
		{tags "glass"}
		{component "glass"}
		{thickness 3}
	}
	{Volume "glass1"
		{tags "glass"}
		{component "glass"}
		{thickness 3}
	}
	{Volume "glass2"
		{tags "glass"}
		{component "glass"}
		{thickness 3}
	}

;====================================
	{extension "crew.ext"}
	{extender "cannon"
		{animation
			{move   "" ""}
			{reload "" "cannon_155gpf_charger"}
			{aim    "" ""}
			{fire   "cannon_gunlayer_fire-alert" ""}
		}
		{animation
			{switch close}
		}
		{move {workers "seat3" "seat4"}}
		{attack {workers "gunner" "charger"}}
		{rotate_ik_Limit 0}
	}
;====================================
	{sensor
		{visor "driver"
			{vision "vehicle_main"}
			{bone "visor"}
		}
		{visor "commander"
			{vision "vehicle_main"}
			{bone "visor_com"}
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{extender "inventory"
		{box	;24 rounds total (23 stowed + 1 loaded)
			{Size 8 8}
			{weight 10000}
			{item "ammo bullet105how_usa fg" 14}
			{item "ammo bullet105how_usa_ar fg" 9}
			{item "smoke_shtora ammo" 8}
		}
	}
	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "105mm_m20_hawkeye" filling "ammo bullet105how_usa fg" 1}
			{gunner "gunner"}
			{charger "charger"}
			{foresight "foresight1"}
			("CW_stab_artillery_rt" rechargetime(7))
		}
		{place "mgun18"
			{type "mgun_left"}
			{weapon "4xsmokegun_bredly" filling "smoke_shtora ammo" 4}
			{gunner "commander"}
			{charger "commander"}
			{foresight "foresight20"}
			{barrels 4}
			{basic}
		}
		{place "mgun19"
			{type "mgun_right"}
			{weapon "4xsmokegun_bredly" filling "smoke_shtora ammo" 4}
			{gunner "commander"}
			{charger "commander"}
			{foresight "foresight21"}
			{barrels 4}
			{basic}
		}
	}

	{mass 6400}
	{Chassis
		("CW_wheels"
			Mass(6.4)
			Turnradius(7.8)
			Power(195)
			Realspeed(95)
			Gamespeed(58)
			Range(440)
			Fuelvolume(95)
		)
		("car_trace" fx("tracewheel04") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel04") step(0.09) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		{DisableMoveWhileFiring}
	}
	{props "cwfs_fuel_80"}
	("two_headlights")

	{Extension "hawkeye_armor.mdl"}
	("missile_aimpoint_trucksize")
	("cwts_buksir")
	{bone "gun_rot"
		{speed 0.005}
	}
	("CW_turr_speed" deg_per_s(15))
}
